# Скопируй этот файл в .env и заполни своими значениями.
# .env не коммитится в git (см. .gitignore).

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_API_KEY=

# API-ключ Groq из https://console.groq.com/keys (обязательно)
GROQ_API_KEY=

# Строка подключения к SQLite (файл БД в папке запуска).
# Если не задать - используется tgbot.db рядом с ботом.
# Таблица user_requests и уникальный индекс создаются автоматически при первом запуске.
# Для другого файла, например:
# DB_CONNECTION_STRING=Data Source=/data/tgbot.db
DB_CONNECTION_STRING=

# Telegram chat_id владельца бота (куда приходят сообщения от пользователей). Необязательно.
CREATOR_CHAT_ID=